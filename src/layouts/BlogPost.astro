---
import Base from '@layouts/Base.astro';
import type { Post } from '@utils/posts';
import FormattedDate from '@components/FormattedDate.astro';
import CalendarIcon from '@icons/CalendarIcon.astro';
import CategoryIcon from '@icons/CategoryIcon.astro';
import { Image } from 'astro:assets';
import config from '@config/config.json';
import type { Locale } from '@config/locales';
import { localizedPath } from '@utils/localized-path';
import { slugify } from '@utils/slug';
import Code from '@components/mdx/Code.astro';

interface Props {
  post: Post;
  locale: Locale;
}

const { locale, post } = Astro.props;
const { title, description, pubDate, updatedDate, categories, tags } = post.data;
const { Content } = await post.render();
---

<Base locale={locale} meta_title={title} description={description} pubDate={pubDate} updatedDate={updatedDate} blogpost>
  <article>
    <div class="md:col-10 mb-12 text-center">
      <h1 class="text-2xl font-bold md:text-4xl">{title}</h1>
      <div class="text-text mt-4 flex flex-wrap items-center justify-center text-zinc-800 dark:text-zinc-200">
        <div class="mx-3 mt-2 flex flex-wrap items-center font-medium">
          <figure>
            <Image
              alt={config.author.name}
              class="mr-2 h-6 w-6 rounded-full"
              width={50}
              height={50}
              src={config.author.avatar}
              decoding="async"
              loading="lazy"
            />
          </figure>
          <span>{config.author.name}</span>
        </div>
        <div class="mx-3 mt-2 flex flex-wrap items-center font-medium">
          <CalendarIcon />
          <FormattedDate date={pubDate} locale={locale} />
        </div>
        <div class="mx-3 mt-2 flex flex-wrap items-center font-medium">
          <CategoryIcon />
          {
            categories?.slice(0, 1).map((category) => (
              <a
                href={localizedPath(locale, `/categories/${slugify(category)}`)}
                class="hover:text-primary mr-2 font-medium capitalize"
              >
                {category}
              </a>
            ))
          }
        </div>
      </div>
    </div>
    <div class="prose prose-zinc max-w-none dark:prose-invert">
      <Content components={{ pre: Code }} />
    </div>
    <div class="mt-8">
      {
        tags?.map((tag) => (
          <a
            href={localizedPath(locale, `/tags/${slugify(tag)}`)}
            class="mb-2 mr-2 inline-block rounded-full bg-zinc-200 px-3 py-1 text-sm font-semibold capitalize text-zinc-700 dark:bg-zinc-900 dark:text-zinc-400"
          >
            #{tag}
          </a>
        ))
      }
    </div>
  </article>
</Base>
