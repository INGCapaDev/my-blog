---
import type { Page } from 'astro';
import Base from '@layouts/Base.astro';
import Posts from '@layouts/Posts.astro';
import Pagination from '@components/Pagination.astro';
import type { Locale } from '@config/locales';
import { ui } from '@config/ui';
import { localizedPath } from '@utils/localized-path';
import type { Post } from '@utils/posts';

interface Props {
  locale: Locale;
  page: Page<Post>;
}

const { locale, page } = Astro.props;
---

<Base locale={locale} meta_title={ui[locale].blogTitle}>
  <h1 class="mb-8 text-2xl font-bold md:text-3xl">{ui[locale].blogTitle}</h1>
  <Posts posts={page.data} locale={locale} />
  <Pagination
    locale={locale}
    length={page.lastPage}
    currentPage={page.currentPage}
    firstUrl={localizedPath(locale, '/blog/')}
    prevUrl={page.url.prev}
    nextUrl={page.url.next}
  />
</Base>
