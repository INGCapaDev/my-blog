---
import type { Locale } from '@config/locales';
import { localizedPath } from '@utils/localized-path';
import type { Post } from '@utils/posts';

interface Props {
  locale: Locale;
  posts: Post[];
}

const { locale, posts } = Astro.props;
const postsByYear = new Map<number, Post[]>();

for (const post of posts) {
  const year = post.data.pubDate.getUTCFullYear();
  const yearPosts = postsByYear.get(year);
  if (yearPosts) yearPosts.push(post);
  else postsByYear.set(year, [post]);
}

const dateFormatter = new Intl.DateTimeFormat(locale, {
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<div class="space-y-12">
  {
    Array.from(postsByYear, ([year, yearPosts]) => (
      <section aria-labelledby={`year-${year}`}>
        <h2 id={`year-${year}`} class="mb-5 text-sm font-medium tabular-nums text-zinc-500 dark:text-zinc-400">
          {year}
        </h2>
        <ul class="space-y-5">
          {yearPosts.map((post) => (
            <li>
              <a
                href={localizedPath(locale, `/blog/${post.slug}/`)}
                class="group flex flex-col gap-1 py-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6"
              >
                <span class="text-lg font-normal leading-snug text-zinc-800 transition-colors group-hover:text-zinc-500 dark:text-zinc-200 dark:group-hover:text-white">
                  {post.data.title}
                </span>
                <time
                  datetime={post.data.pubDate.toISOString()}
                  class="shrink-0 text-sm text-zinc-500 dark:text-zinc-400"
                >
                  {dateFormatter.format(post.data.pubDate)}
                </time>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>
