---
import Base from '@layouts/Base.astro';
---

<Base locale="en" meta_title="Page not found" description="The requested page could not be found." noindex>
  <section class="py-16 sm:py-24" aria-labelledby="not-found-title">
    <p class="mb-4 font-mono text-sm text-zinc-500 dark:text-zinc-400">404</p>
    <h1 id="not-found-title" class="text-3xl font-semibold tracking-tight">Nothing here.</h1>
    <p class="mt-4 text-zinc-500 dark:text-zinc-400">This page may have moved, or never existed.</p>
    <nav aria-label="Return to the blog" class="mt-8 flex flex-wrap gap-x-6 gap-y-3 text-sm">
      <a
        href="/"
        class="text-zinc-700 underline decoration-zinc-300 underline-offset-4 transition-colors hover:text-zinc-950 dark:text-zinc-300 dark:decoration-zinc-700 dark:hover:text-white"
      >
        Read the posts <span aria-hidden="true">→</span>
      </a>
      <a
        href="/es/"
        lang="es"
        class="text-zinc-700 underline decoration-zinc-300 underline-offset-4 transition-colors hover:text-zinc-950 dark:text-zinc-300 dark:decoration-zinc-700 dark:hover:text-white"
      >
        Leer en español <span aria-hidden="true">→</span>
      </a>
    </nav>
  </section>
</Base>
