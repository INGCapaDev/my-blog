---
import type { InferGetStaticPropsType } from 'astro';
import TaxonomyPosts from '@layouts/TaxonomyPosts.astro';
import { getTaxonomyPages } from '@utils/taxonomy';

export async function getStaticPaths() {
  return getTaxonomyPages('es', 'categories');
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
---

<TaxonomyPosts {...Astro.props} />
