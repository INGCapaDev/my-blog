---
import { locales, type Locale } from '@config/locales';

interface Props {
  date: Date;
  locale: Locale;
}

const { date, locale } = Astro.props;
---

<time datetime={date.toISOString()}>
  {
    date.toLocaleDateString(locales[locale].dateLocale, {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    })
  }
</time>
